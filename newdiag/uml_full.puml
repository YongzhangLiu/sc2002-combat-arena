    class TextFormatUtil <<Static>>
    class ViewMapperUtil <<Static>>
}

' ═══════════════════════════════════════
' RELATIONSHIPS
' ═══════════════════════════════════════

' ── Combatant hierarchy ─────────────────
Combatant <|-- Player
Combatant <|-- Enemy
Player    <|-- Warrior
Player    <|-- Wizard
Enemy     <|-- Goblin
Enemy     <|-- Wolf

' ── Effect hierarchy ────────────────────
StatusEffect <|-- DefendBuff
StatusEffect <|-- StunEffect
StatusEffect <|-- SmokeBombEffect

' ── Item hierarchy ──────────────────────
Item <|-- Potion
Item <|-- PowerStone
Item <|-- SmokeBomb

' ── Action hierarchy ────────────────────
Action <|-- BasicAttack
Action <|-- Defend
Action <|-- UseItem
Action <|-- UseSpecialSkill

' ── Strategy implementations ────────────
TurnOrderStrategy    <|..  SpeedBasedTurnOrder
EnemyActionStrategy  <|..  BasicEnemyActionStrategy
AiTurnController     <|..  RandomAiTurnController
QtePolicy            <|..  NoOpQtePolicy
QtePolicy            <|..  CustomModeQtePolicy
GameMode             <|..  StandardMode
GameMode             <|..  CustomDuelMode

' ── Domain compositions ─────────────────
Combatant "1" *-- "0..*" StatusEffect : activeEffects
Player    "1" *-- "0..*" Item          : inventory
Enemy          -->        EnemyActionStrategy : strategy

' ── Action associations ─────────────────
UseItem         --> Item            : holds
UseSpecialSkill ..> Player          : casts → useSpecialSkill()
Defend          ..> DefendBuff      : creates
SmokeBomb       ..> SmokeBombEffect : creates
PowerStone      ..> Player          : calls triggerSpecialSkill

' ── Engine core ─────────────────────────
BattleEngine  -->  GameState
BattleEngine  -->  PlayerAction
BattleEngine  -->  AiTurnController
BattleEngine  *--  TurnFrame
GameInit      -->  GameState

' ── Engine controller ───────────────────
AiTurnController       <|..  RandomAiTurnController
RandomAiTurnController -->   PlayerAction
RandomAiTurnController ..>   AiTurnResult : creates

' ── Engine mode ─────────────────────────
GameModeFactory  ..>  GameMode    : creates
StandardMode     ..>  GameInit    : calls initEnemies
CustomDuelMode   ..>  GameInit    : calls initCustomEnemies

' ── Engine QTE ──────────────────────────
NoOpQtePolicy        ..>  QteResult
CustomModeQtePolicy  ..>  QteResult
CustomModeQtePolicy  ..>  TimingBarQteView

' ── Strategy usage ──────────────────────
GameState  ..>  TurnOrderStrategy : uses

' ── GameApp wiring ──────────────────────
GameApp --> StartMenu
GameApp --> BattleEngine
GameApp --> GameInit
GameApp --> GameModeFactory
GameApp --> QtePolicy
GameApp --> ArenaBattleScreen
GameApp --> ArenaViewStateMapper
GameApp --> EndgameScreen
GameApp ..> ActionCallbacks  : implements (anon)
GameApp ..> EndgameCallbacks : implements (anon)

' ── UI entry ────────────────────────────
GameStartRequest  *--  GameSetup
StartMenu         ..>  GameStartRequest : produces
StartMenu         ..>  PlayerSelectionScreen
StartMenu         ..>  ItemSelectionScreen
StartMenu         ..>  DifficultySelectionScreen
StartMenu         ..>  EnemyInformationScreen
StartMenu         ..>  CustomModeSetupScreen

' ── UI screen ───────────────────────────
ArenaBattleScreen    ..>  ActionCallbacks  : uses
ArenaBattleScreen    -->  ArenaLayoutCalculator
ArenaBattleScreen    -->  ArenaViewState
EndgameScreen        ..>  EndgameCallbacks : uses
ArenaPreviewStateFactory ..> ArenaViewState

' ── UI model ────────────────────────────
ArenaViewStateMapper  ..>  ArenaViewState : creates
ArenaViewStateMapper  ..>  GameState
ArenaViewState        *--  PlayerViewState
ArenaViewState        *--  EnemyViewState
PlayerViewState       *--  StatusIconViewState
EnemyViewState        *--  StatusIconViewState

' ── UI sprite ───────────────────────────
SpriteCatalog ..> AsciiSprite : loads

@enduml
