@startuml uml_overview
title System Overview — Layer Architecture

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam class {
    BackgroundColor White
    BorderColor Black
}
skinparam package {
    BorderColor #555555
}

hide empty members

' ── GameApp lives outside any layer — it orchestrates all of them ──
class GameApp {
    + run() : void
    + {static} main(args) : void
    - startGameSession(request) : void
    - handlePlayerTurn(state, screen, engine) : void
}

package "UI Layer" #FCE4EC {
    class StartMenu <<Static>>
    class ArenaBattleScreen
    class EndgameScreen <<Static>>
    class ArenaViewState
}

package "Engine Layer" #F3E5F5 {
    class BattleEngine {
        + executePlayerTurn(choice, target, item) : int
        + sweepDeadEnemies() : void
        + drainTurnFrames() : List<TurnFrame>
    }
    class GameState <<Static>> {
        + {static} checkEndCondition() : int
        + {static} newTurnOrder() : void
        + {static} advanceWaveIfCleared() : boolean
    }
    class GameInit
    class PlayerAction
    class GameModeFactory <<Static>>
    interface GameMode
    interface QtePolicy
}

package "Strategy Layer" #E3F2FD {
    interface TurnOrderStrategy
    interface EnemyActionStrategy
    class SpeedBasedTurnOrder
    class BasicEnemyActionStrategy
    interface AiTurnController
    class RandomAiTurnController
}

package "Domain Layer" #FFFDE7 {
    abstract class Combatant
    abstract class Player
    abstract class Enemy
    class Warrior
    class Wizard
    class Goblin
    class Wolf
    abstract class Item
    abstract class Action
    abstract class StatusEffect
}

' ── GameApp connections ────────────────────────
GameApp          -->  StartMenu
GameApp          -->  BattleEngine
GameApp          -->  GameInit
GameApp          -->  ArenaViewState
GameApp          -->  ArenaBattleScreen
GameApp          -->  EndgameScreen
GameApp          -->  GameModeFactory
GameApp          -->  QtePolicy

' ── Engine Layer connections ───────────────────
BattleEngine     -->  GameState
BattleEngine     -->  PlayerAction
BattleEngine     -->  AiTurnController
GameModeFactory  ..>  GameMode
GameInit         -->  GameState

' ── Strategy Layer connections ─────────────────
TurnOrderStrategy    <|..  SpeedBasedTurnOrder
EnemyActionStrategy  <|..  BasicEnemyActionStrategy
AiTurnController     <|..  RandomAiTurnController

GameState        ..>  TurnOrderStrategy : uses
Enemy            -->  EnemyActionStrategy : uses

' ── Domain Layer connections ───────────────────
Combatant <|-- Player
Combatant <|-- Enemy
Player    <|-- Warrior
Player    <|-- Wizard
Enemy     <|-- Goblin
Enemy     <|-- Wolf
Player    *--  Item
Combatant *--  StatusEffect

@enduml
