@startuml Scenario_5
hide footbox
title Scenario 5: Enemy Turn - Goblin Is Stunned, Skips Turn

participant GameApp
participant BattleEngine
participant GameState
participant "Goblin" as Goblin
participant "StunEffect\n(StatusEffect)" as StunEffect

note over Goblin: StunEffect active (remainingTurns=2)

GameApp -> BattleEngine: advanceTurnQueue()
BattleEngine -> GameState: checkEndCondition()
GameState --> BattleEngine: 0 (continue)
BattleEngine -> GameState: getTurnOrder()
GameState --> BattleEngine: [Goblin, ...]

note over BattleEngine: currentAttacker = Goblin (instanceof Enemy)

BattleEngine -> Goblin: isAlive()
Goblin --> BattleEngine: true

BattleEngine -> Goblin: beginTurn()
note over Goblin: Iterates activeEffects\ncalls StunEffect.onTurnStart(goblin)
Goblin -> StunEffect: onTurnStart(goblin)
note over StunEffect: remainingTurns > 0\nremainingTurns-- (2 -> 1)\nreturn true (skip turn)
StunEffect --> Goblin: true (skip turn)
note over Goblin: canAct = false\nStunEffect.isExpired()? turns=1 -> false\nStunEffect remains active\nreturns false
Goblin --> BattleEngine: false (cannot act)

note over BattleEngine: enemy.beginTurn() == false\nAI strategy NOT executed\nenemyActed = false

BattleEngine -> BattleEngine: sweepDeadEnemies()
note over BattleEngine: Goblin hp > 0, still alive\nnothing removed

BattleEngine -> GameState: getTurnOrder() [remove Goblin from front]
BattleEngine -> GameState: checkEndCondition()
GameState --> BattleEngine: 0 (continue)

note over BattleEngine: enemyActed = false -> do NOT pause\nTurn queue now empty -> endRound()

BattleEngine -> BattleEngine: endRound()
BattleEngine -> GameState: setCurrentRound(round + 1)
BattleEngine -> GameState: getPlayer()
GameState --> BattleEngine: Warrior
BattleEngine -> Warrior: decrementCooldownAfterTurn()
note over Warrior: specialSkillCooldown-- (3 -> 2)
BattleEngine -> GameState: newTurnOrder()
note over GameState: SpeedBasedTurnOrder rebuilds\n[Warrior, Goblin]

BattleEngine --> GameApp: 0 (player's turn next)

@enduml
