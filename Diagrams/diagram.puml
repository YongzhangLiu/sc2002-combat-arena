@startuml SC2002_CombatArena

title SC2002 Combat Arena - UML Class Diagram

skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam groupInheritance 2

skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}

skinparam package {
    BackgroundColor AliceBlue
    BorderColor Navy
    FontStyle Bold
}

hide empty members

' =============================================
' DOMAIN LAYER - arena.model
' =============================================

package "arena.model.combatant" #LightYellow {

    abstract class Combatant {
        - name : String
        - hp : int
        - maxHp : int
        - attack : int
        - baseDefense : int
        - speed : int
        - activeEffects : List<StatusEffect>
        - description : String
        ..
        + getName() : String
        + getHp() : int
        + getMaxHp() : int
        + getAttack() : int
        + getDefense() : int
        + getSpeed() : int
        + isAlive() : boolean
        + heal(amount : int) : void
        + takeDamage(dmg : int) : int
        + takeDamage(dmg : int, src : Combatant) : int
        + beginTurn() : boolean
        + addStatusEffect(e : StatusEffect) : void
        + hasEffect(type : Class) : boolean
        + getActiveEffects() : List<StatusEffect>
        # increaseAttack(amount : int) : void
    }

    abstract class Player {
        - SPECIAL_SKILL_COOLDOWN : int = 3
        - specialSkillCooldown : int
        - inventory : List<Item>
        ..
        + canUseSpecialSkill() : boolean
        + getSpecialSkillCooldown() : int
        + useSpecialSkill(enemies : List<Enemy>, target : Enemy) : void
        + triggerSpecialSkillWithoutCooldown(enemies : List<Enemy>, target : Enemy) : void
        + decrementCooldownAfterTurn() : void
        # performSpecialSkill(enemies : List<Enemy>, target : Enemy) : void
        + addItem(item : Item) : void
        + removeItem(item : Item) : boolean
        + getInventory() : List<Item>
    }

    abstract class Enemy {
        - strategy : EnemyActionStrategy
        ..
        + getStrategy() : EnemyActionStrategy
    }

    class Warrior {
        HP=260  ATK=40  DEF=20  SPD=30
        ..
        + Warrior(name : String)
        # performSpecialSkill(enemies : List<Enemy>, target : Enemy) : void
    }

    class Wizard {
        HP=200  ATK=50  DEF=10  SPD=20
        ..
        + Wizard(name : String)
        # performSpecialSkill(enemies : List<Enemy>, target : Enemy) : void
    }

    class Goblin {
        HP=55  ATK=35  DEF=15  SPD=25
        ..
        + Goblin(name : String)
    }

    class Wolf {
        HP=40  ATK=45  DEF=5  SPD=35
        ..
        + Wolf(name : String)
    }
}

package "arena.model.effect" #LightYellow {

    abstract class StatusEffect {
        - name : String
        # remainingTurns : int
        ..
        + getName() : String
        + getRemainingTurns() : int
        + isExpired() : boolean
        + onApply(c : Combatant) : void
        + onExpire(c : Combatant) : void
        + onTurnStart(c : Combatant) : boolean
        + modifyDefense(base : int) : int
        + modifyIncomingDamage(dmg : int, src : Combatant, tgt : Combatant) : int
    }

    class DefendBuff {
        - defenseBoost : int
        ..
        + DefendBuff()
        + DefendBuff(boost : int, turns : int)
        + onTurnStart(c : Combatant) : boolean
        + modifyDefense(base : int) : int
    }

    class StunEffect {
        DEFAULT_DURATION : int = 2
        ..
        + StunEffect()
        + StunEffect(turns : int)
        + onTurnStart(c : Combatant) : boolean
    }

    class SmokeBombEffect {
        + SmokeBombEffect()
        + SmokeBombEffect(turns : int)
        + onTurnStart(c : Combatant) : boolean
        + modifyIncomingDamage(dmg : int, src : Combatant, tgt : Combatant) : int
    }
}

package "arena.model.item" #LightYellow {

    abstract class Item {
        - name : String
        - description : String
        ..
        + getName() : String
        + getDescription() : String
        + use(player : Player, enemies : List<Enemy>, target : Enemy) : void
    }

    class Potion {
        HEAL_AMOUNT : int = 100
        ..
        + Potion()
        + use(player : Player, enemies : List<Enemy>, target : Enemy) : void
    }

    class PowerStone {
        + PowerStone()
        + use(player : Player, enemies : List<Enemy>, target : Enemy) : void
    }

    class SmokeBomb {
        + SmokeBomb()
        + use(player : Player, enemies : List<Enemy>, target : Enemy) : void
    }
}

package "arena.model.action" #LightYellow {

    abstract class Action {
        - name : String
        ..
        + getName() : String
        + execute(actor : Combatant, target : Combatant, all : List<Combatant>) : void
    }

    class BasicAttack {
        + BasicAttack()
        + execute(actor : Combatant, target : Combatant, all : List<Combatant>) : void
    }

    class Defend {
        + Defend()
        + execute(actor : Combatant, target : Combatant, all : List<Combatant>) : void
    }

    class UseItem {
        - item : Item
        ..
        + UseItem(item : Item)
        + execute(actor : Combatant, target : Combatant, all : List<Combatant>) : void
    }

    class UseSpecialSkill {
        + UseSpecialSkill()
        + execute(actor : Combatant, target : Combatant, all : List<Combatant>) : void
    }
}

' =============================================
' STRATEGY LAYER - arena.strategy
' =============================================

package "arena.strategy" #LightCyan {

    interface TurnOrderStrategy {
        + buildTurnOrder(players : List<Player>, enemies : List<Enemy>) : List<Combatant>
    }

    class SpeedBasedTurnOrder {
        + buildTurnOrder(players : List<Player>, enemies : List<Enemy>) : List<Combatant>
    }

    interface EnemyActionStrategy {
        + execute(enemy : Enemy, players : List<Player>) : void
    }

    class BasicEnemyActionStrategy {
        + execute(enemy : Enemy, players : List<Player>) : void
    }
}

' =============================================
' ENGINE LAYER - arena.engine
' =============================================

package "arena.engine" #LightGreen {

    class GameState <<Static Utility>> {
        - {static} currentRound : int
        - {static} players : List<Player>
        - {static} enemies : List<List<Enemy>>
        - {static} turnOrder : List<Combatant>
        - {static} combatLog : Deque<String>
        + {static} MAX_LOG_LINES : int = 4
        ..
        + {static} addLog(msg : String) : void
        + {static} getCombatLog() : Deque<String>
        + {static} getPlayer() : Player
        + {static} getCurrentRound() : int
        + {static} getCurrentAttacker() : Combatant
        + {static} getCurrentWave() : List<Enemy>
        + {static} getTurnOrder() : List<Combatant>
        + {static} setCurrentWave(wave : List<Enemy>) : void
        + {static} newTurnOrder() : void
        + {static} checkEndCondition() : int
        + {static} advanceWaveIfCleared() : boolean
    }

    class BattleEngine {
        - lastPlayerDamage : int
        - lastEnemyDamages : List<Integer>
        ..
        + getLastPlayerDamage() : int
        + getLastEnemyDamages() : List<Integer>
        + executePlayerTurn(choice : int, targetIdx : int, item : Item) : int
        + advanceTurnQueue() : int
        + sweepDeadEnemies() : void
        + endRound() : void
    }

    class PlayerAction {
        + bAttack(player : Player, target : Enemy) : void
        + defend(player : Player) : void
        + specialSkill(player : Player, target : Enemy, enemies : List<Enemy>) : void
        + consumeItem(player : Player, target : Enemy, enemies : List<Enemy>, item : Item) : void
    }

    class GameInit {
        + initPlayers(choice : int, name : String) : Player
        + chooseItems(player : Player, choice : int) : void
        + initEnemies(difficulty : int) : List<List<Enemy>>
        + startGame() : void
    }
}

' =============================================
' UI VIEW-STATE LAYER - arena.ui.model
' =============================================

package "arena.ui.model" #MistyRose {

    class ArenaViewState {
        - roundNumber : int
        - turnOwnerName : String
        - isPlayerTurn : boolean
        - playerState : PlayerViewState
        - aliveEnemies : List<EnemyViewState>
        - currentTargetIndex : int
        - availableActions : List<String>
        - availableItems : List<String>
        - combatLog : List<String>
        - feedbackMessage : String
        - victory : boolean
        - defeat : boolean
        ..
        + getCurrentTarget() : EnemyViewState
        + isGameOver() : boolean
    }

    class PlayerViewState {
        + name : String
        + type : String
        + currentHp : int
        + maxHp : int
        + attack : int
        + defense : int
        + speed : int
        + spriteKey : String
        + specialSkillCooldown : int
        + isSpecialSkillAvailable : boolean
        + hasItems : boolean
        + floatingDamage : Integer
        + activeEffects : List<StatusIconViewState>
    }

    class EnemyViewState {
        + targetIndex : int
        + name : String
        + type : String
        + currentHp : int
        + maxHp : int
        + isAlive : boolean
        + floatingDamage : Integer
        + activeEffects : List<StatusIconViewState>
        ..
        + getHpPercent() : int
    }

    class StatusIconViewState {
        - effectName : String
        - remainingTurns : int
        - iconSymbol : String
        ..
        + getEffectName() : String
        + getRemainingTurns() : int
        + getIconSymbol() : String
    }

    class ArenaViewStateMapper <<Static Utility>> {
        + {static} fromGameState(isPlayerTurn : boolean, victory : boolean, feedback : String) : ArenaViewState
        + {static} fromGameState(isPlayerTurn : boolean, victory : boolean, feedback : String, playerDmg : Integer) : ArenaViewState
        + {static} fromGameState(isPlayerTurn : boolean, victory : boolean, feedback : String, playerDmg : Integer, enemyDmgs : List<Integer>) : ArenaViewState
    }
}

' =============================================
' UI SCREEN LAYER - arena.ui.screen
' =============================================

package "arena.ui.screen" #MistyRose {

    class ArenaBattleScreen {
        - layoutCalculator : ArenaLayoutCalculator
        - fullScreen : boolean
        - asciiMode : boolean
        - lastRenderedState : ArenaViewState
        - uiSelectedTargetIndex : int
        ..
        + initialize(screen : Screen, gui : MultiWindowTextGUI, fullScreen : boolean, asciiMode : boolean) : void
        + render(state : ArenaViewState) : void
        + showAndWait(state : ArenaViewState) : void
        + setCallbacks(cb : ActionCallbacks) : void
        + close() : void
        + getLastRenderedState() : ArenaViewState
    }

    interface ActionCallbacks {
        + onBasicAttack(targetIndex : int) : void
        + onDefend() : void
        + onUseItem(itemIndex : int, targetIndex : int) : void
        + onSpecialSkill(targetIndex : int) : void
        + onBackToMenu() : void
    }

    class ArenaLayoutCalculator {
        + calculate(size : TerminalSize) : LayoutBounds
        + getEnemySlotWidth(count : int, arenaWidth : int) : int
    }

    class PlayerSelectionScreen <<Static>> {
        + {static} open(screen : Screen, gui : MultiWindowTextGUI, fullScreen : boolean, asciiMode : boolean, setup : GameSetup) : int
    }

    class ItemSelectionScreen <<Static>> {
        + {static} open(screen : Screen, gui : MultiWindowTextGUI, fullScreen : boolean, asciiMode : boolean, setup : GameSetup) : int
    }

    class DifficultySelectionScreen <<Static>> {
        + {static} open(screen : Screen, gui : MultiWindowTextGUI, fullScreen : boolean, asciiMode : boolean, setup : GameSetup) : int
    }

    class EnemyInformationScreen <<Static>> {
        + {static} open(screen : Screen, gui : MultiWindowTextGUI, fullScreen : boolean, asciiMode : boolean) : int
    }

    class EndgameScreen <<Static>> {
        + {static} show(screen : Screen, gui : MultiWindowTextGUI, victory : boolean, round : int, cb : EndgameCallbacks) : void
    }

    interface EndgameCallbacks {
        + onBackToMenu() : void
        + onQuit() : void
    }

    class ArenaPreviewStateFactory <<Static>> {
        + {static} fromSetup(setup : GameSetup) : ArenaViewState
    }
}

' =============================================
' UI ENTRY / SETUP - arena.ui
' =============================================

package "arena.ui" #MistyRose {

    class StartMenu <<Static>> {
        + {static} launch(fullScreen : boolean, asciiMode : boolean, onStart : Consumer<GameSetup>) : void
        + {static} applyUniformButtonTheme(gui : MultiWindowTextGUI) : void
    }

    class GameSetup {
        + playerClass : String
        + item : String
        + difficulty : String
        ..
        + GameSetup(playerClass : String, item : String, difficulty : String)
    }
}

' =============================================
' UI SPRITES - arena.ui.sprite
' =============================================

package "arena.ui.sprite" #MistyRose {

    class AsciiSprite {
        - lines : List<String>
        - width : int
        - height : int
        ..
        + getLines() : List<String>
        + fits(w : int, h : int) : boolean
        + clipRight(w : int, h : int) : AsciiSprite
        + toMultilineText() : String
    }

    class SpriteCatalog <<Static>> {
        + {static} loadArenaStrip(key : String, row : int) : AsciiSprite
        + {static} loadCloudStrip(row : int) : AsciiSprite
        + {static} load(folder : String, name : String, variant : String) : AsciiSprite
        + {static} loadExact(folder : String, file : String) : AsciiSprite
    }
}

' =============================================
' APPLICATION ENTRY POINT - arena
' =============================================

package "arena" #Lavender {

    class GameApp {
        - screen : Screen
        - gui : MultiWindowTextGUI
        ..
        + run() : void
        + {static} main(args : String[]) : void
        - initializeTerminal() : void
        - startGameSession(setup : GameSetup) : void
        - handlePlayerTurn(choice : int, battleScreen : ArenaBattleScreen, engine : BattleEngine) : void
        - handleTurnResult(result : int, battleScreen : ArenaBattleScreen, engine : BattleEngine) : void
        - checkEndCondition(result : int, victory : boolean) : boolean
        - closeTerminal() : void
    }
}

' =============================================
' ALL RELATIONSHIPS
' =============================================

' --- Combatant hierarchy ---
Combatant <|-- Player
Combatant <|-- Enemy
Player    <|-- Warrior
Player    <|-- Wizard
Enemy     <|-- Goblin
Enemy     <|-- Wolf

' --- StatusEffect hierarchy ---
StatusEffect <|-- DefendBuff
StatusEffect <|-- StunEffect
StatusEffect <|-- SmokeBombEffect

' --- Item hierarchy ---
Item <|-- Potion
Item <|-- PowerStone
Item <|-- SmokeBomb

' --- Action hierarchy ---
Action <|-- BasicAttack
Action <|-- Defend
Action <|-- UseItem
Action <|-- UseSpecialSkill

' --- Strategy implementations ---
TurnOrderStrategy   <|.. SpeedBasedTurnOrder
EnemyActionStrategy <|.. BasicEnemyActionStrategy

' --- Combatant associations ---
Combatant "1" *-- "0..*" StatusEffect : activeEffects
Player    "1" *-- "0..*" Item         : inventory
Enemy          -->        EnemyActionStrategy : strategy

' --- Action associations ---
UseItem ..> Item
Defend  ..> DefendBuff
UseSpecialSkill ..> Player

' --- Effect creation ---
Warrior   ..> StunEffect       : creates
SmokeBomb ..> SmokeBombEffect  : creates

' --- Strategy usage ---
Goblin ..> BasicEnemyActionStrategy : uses
Wolf   ..> BasicEnemyActionStrategy : uses

' --- Engine layer ---
BattleEngine -->  PlayerAction
BattleEngine -->  GameState
PlayerAction -->  GameState
PlayerAction ..>  BasicAttack
PlayerAction ..>  Defend
PlayerAction ..>  UseItem
PlayerAction ..>  UseSpecialSkill
GameState    ..>  SpeedBasedTurnOrder : uses

GameInit ..> Warrior
GameInit ..> Wizard
GameInit ..> Goblin
GameInit ..> Wolf
GameInit ..> Potion
GameInit ..> PowerStone
GameInit ..> SmokeBomb

' --- UI view-state ---
ArenaViewState       *--  PlayerViewState
ArenaViewState       *--  EnemyViewState
PlayerViewState      *--  StatusIconViewState
EnemyViewState       *--  StatusIconViewState
ArenaViewStateMapper ..>  ArenaViewState
ArenaViewStateMapper ..>  GameState

' --- UI screen ---
ArenaBattleScreen -->  ArenaLayoutCalculator
ArenaBattleScreen -->  ArenaViewState
ArenaBattleScreen ..>  ActionCallbacks : uses
EndgameScreen     ..>  EndgameCallbacks : uses
ArenaPreviewStateFactory ..> ArenaViewState
ArenaPreviewStateFactory ..> GameSetup

' --- UI entry ---
StartMenu ..> PlayerSelectionScreen
StartMenu ..> ItemSelectionScreen
StartMenu ..> EnemyInformationScreen
StartMenu ..> DifficultySelectionScreen
StartMenu ..> GameSetup

' --- Sprites ---
SpriteCatalog ..> AsciiSprite

' --- App entry point ---
GameApp --> StartMenu
GameApp --> GameInit
GameApp --> BattleEngine
GameApp --> GameState
GameApp --> ArenaBattleScreen
GameApp --> ArenaViewStateMapper

@enduml
