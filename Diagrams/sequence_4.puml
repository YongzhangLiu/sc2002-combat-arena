@startuml Scenario_4
hide footbox
title Scenario 4: Player Turn - Warrior Uses Shield Bash, Stunning Goblin

participant GameApp
participant BattleEngine
participant GameState
participant PlayerAction
participant "UseSpecialSkill\n(Action)" as UseSpecialSkill
participant "Warrior" as Warrior
participant "DefendBuff\n(StatusEffect)" as DefendBuff
participant "StunEffect\n(StatusEffect)" as StunEffect
participant "Goblin" as Goblin

note over Warrior: DefendBuff active (turns=2)\nspecialSkillCooldown = 0

GameApp -> BattleEngine: executePlayerTurn(4, targetIdx, null)
BattleEngine -> GameState: getPlayer()
GameState --> BattleEngine: Warrior
BattleEngine -> GameState: getCurrentWave()
GameState --> BattleEngine: [Goblin]

BattleEngine -> Warrior: beginTurn()
note over Warrior: Iterates activeEffects\ncalls DefendBuff.onTurnStart(warrior)
Warrior -> DefendBuff: onTurnStart(warrior)
note over DefendBuff: remainingTurns > 0\nremainingTurns-- (2 -> 1)\nreturn false (do NOT skip turn)
DefendBuff --> Warrior: false
note over Warrior: DefendBuff.isExpired()? turns=1 -> false, keep it\ncanAct = true\nreturns true
Warrior --> BattleEngine: true (can act)

note over BattleEngine: switch(playerChoice=4) -> special skill branch
BattleEngine -> GameState: addLog("Warrior used Shield Bash on Goblin")
BattleEngine -> PlayerAction: specialSkill(warrior, goblin, [goblin])

PlayerAction -> UseSpecialSkill: new UseSpecialSkill()
PlayerAction -> UseSpecialSkill: execute(warrior, goblin, [goblin])

note over UseSpecialSkill: actor instanceof Player -> ok\ncast opponents to List<Enemy>
UseSpecialSkill -> Warrior: useSpecialSkill([goblin], goblin)

Warrior -> Warrior: canUseSpecialSkill()
note over Warrior: specialSkillCooldown == 0 -> true
Warrior --> Warrior: true

Warrior -> Warrior: performSpecialSkill([goblin], goblin)
note over Warrior: Warrior.performSpecialSkill:\ndamage = max(0, getAttack() - goblin.getDefense())
Warrior -> Warrior: getAttack()
Warrior --> Warrior: 40
Warrior -> Goblin: getDefense()
note over Goblin: baseDefense = 15, no active effects
Goblin --> Warrior: 15
note over Warrior: damage = max(0, 40 - 15) = 25

Warrior -> Goblin: takeDamage(25, warrior)
note over Goblin: No active effects\nadjusted = 25\nhp = hp - 25
Goblin --> Warrior: 25 (damage dealt)

Warrior -> StunEffect: new StunEffect()
note over StunEffect: DEFAULT_DURATION = 2\nremainingTurns = 2
Warrior -> Goblin: addStatusEffect(stunEffect)
Goblin -> StunEffect: onApply(goblin)
note over Goblin: stunEffect appended to activeEffects

Warrior -> Warrior: specialSkillCooldown = 3
Warrior --> UseSpecialSkill: (done)
UseSpecialSkill --> PlayerAction: (done)
PlayerAction --> BattleEngine: (done)

BattleEngine -> GameState: getTurnOrder() [remove Warrior from front]
BattleEngine -> GameState: checkEndCondition()
GameState --> BattleEngine: 0 (continue)

BattleEngine --> GameApp: 0 (player turn done, await next input)

@enduml
